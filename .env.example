# Copy to .env for local runs (gitignored). Prefer your agent host's secure secret entry instead.
# Never commit real values. Never paste keys into chat, issues, skills or logs.

# Your own TMDB API key (see docs/tmdb-api-key-setup.md). Needed for the TMDB spec path.
TMDB_API_KEY=

# Paths (defaults shown)
MOVIEBOT_DB=./moviebot.db
MOVIEBOT_BACKUP_DIR=./backups
MOVIEBOT_CONFIG=./config/local.json
MOVIEBOT_TZ=America/New_York

# Optional photo-frame integration
RAW_DB=./raw_votes.db
RECS=./recommendations.json
# Wake webhook values go in a gitignored wake-webhook.env that the owner fills in themselves.
